# ── LINE Messaging API (LINE Developers Console → your channel) ──────────────
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OpenRouter (LLM) — https://openrouter.ai/keys ────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# Any model that supports BOTH vision and tool calling (see openrouter.ai/models).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ── Data repo: a PRIVATE GitHub repo that stores the markdown care log ───────
# Create a fine-grained personal access token with Contents: Read and write
# scoped to just this repo.
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=your-username/care-log
GITHUB_BRANCH=main
# Optional: put all bot files under a subdirectory of the repo (e.g. when the
# repo IS your whole Obsidian vault). Leave empty to use the repo root.
DATA_ROOT=

# ── Voice transcription (optional; Groq free tier, https://console.groq.com) ─
# If unset, the bot politely tells users voice messages aren't enabled yet.
GROQ_API_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
# IANA timezone used for log dates/times.
TIMEZONE=Asia/Taipei
